{
  // SCAFFOLD — pending approval of specs/innings-break/runtime.md (issue #83).
  // Do not deploy. Always pass --env. A bare `wrangler deploy` is not an environment.
  // database_id values are placeholders. Paste the same id the customer API uses.
  // No migrations_dir: migrations are applied once per environment by a later ticket.
  "name": "ib-console-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "env": {
    "dev": {
      "name": "ib-console-api-dev",
      "vars": {
        "ENVIRONMENT": "dev",
        "CORS_ORIGIN": "https://dev.yogeshkumarasamy.in"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ib-dev",
          "database_id": "REPLACE_WITH_ib-dev_DATABASE_ID"
        }
      ],
      "triggers": {
        "crons": []
      }
    },
    "staging": {
      "name": "ib-console-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "CORS_ORIGIN": "https://staging.yogeshkumarasamy.in"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ib-staging",
          "database_id": "REPLACE_WITH_ib-staging_DATABASE_ID"
        }
      ],
      "triggers": {
        "crons": []
      }
    },
    "production": {
      "name": "ib-console-api-prod",
      "vars": {
        "ENVIRONMENT": "production",
        "CORS_ORIGIN": "https://yogeshkumarasamy.in"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ib-prod",
          "database_id": "REPLACE_WITH_ib-prod_DATABASE_ID"
        }
      ],
      "triggers": {
        "crons": []
      }
    },
    "preview": {
      "name": "ib-console-api-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "CORS_ORIGIN": "https://dev.yogeshkumarasamy.in"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ib-pr-UNSET",
          "database_id": "REPLACE_WITH_ib-pr-N_DATABASE_ID"
        }
      ],
      // Empty array clears crons on deploy. Omitting `triggers` would leave one in place.
      "triggers": {
        "crons": []
      }
    }
  }
}
