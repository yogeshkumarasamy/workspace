{
  "name": "@apps/yt-scheduler-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "yt-scheduler API on Cloudflare Workers (D1, mock YouTube outside production).",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "deploy": "node -e \"console.error('Use: node deploy/yt-worker.mjs deploy --env dev'); process.exit(1)\""
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^20.17.10",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "5.5.4",
    "vitest": "^2.1.8",
    "wrangler": "^4.42.0"
  }
}
