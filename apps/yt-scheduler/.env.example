# Google OAuth (Web application client) - see README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback
# Postgres (Neon/Supabase free tier or docker-compose)
DATABASE_URL=postgres://yt:yt@localhost:5432/yt
# Agents send this in the x-api-key header; UI asks for it once
API_KEY=change-me-long-random
# 32-byte key, base64: openssl rand -base64 32
ENCRYPTION_KEY=
APP_URL=http://localhost:8787
PORT=8787
# Worker tick interval
TICK_SECONDS=30
DAILY_QUOTA_UNITS=10000
SCHEDULE_TIMEZONE=Asia/Kolkata
SHORTS_TIME=07:00
LONG_WEEKDAY=6
LONG_TIME=18:00
