{
  "$ref": "#/definitions/Metadata",
  "definitions": {
    "Metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 5000,
          "default": ""
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "categoryId": {
          "type": "string",
          "pattern": "^\\d+$",
          "default": "1"
        },
        "defaultLanguage": {
          "type": "string",
          "default": "ta"
        },
        "defaultAudioLanguage": {
          "type": "string",
          "default": "ta"
        },
        "madeForKids": {
          "type": "boolean",
          "default": true
        },
        "containsSyntheticMedia": {
          "type": "boolean",
          "default": false
        },
        "type": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ],
          "default": "long"
        },
        "privacyStatus": {
          "type": "string",
          "enum": [
            "private",
            "unlisted",
            "public"
          ],
          "default": "private"
        },
        "publishAt": {
          "type": "string",
          "format": "date-time"
        },
        "playlist": {
          "type": "string",
          "minLength": 1
        },
        "createPlaylistIfMissing": {
          "type": "boolean",
          "default": false
        },
        "channel": {
          "type": "string",
          "minLength": 2
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
