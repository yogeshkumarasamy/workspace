{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc"],
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.md",
        "!**/*.test.*",
        "!e2e/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "contract:check": {
      "inputs": ["src/**", "scripts/**", "test/**", "openapi.json", "migrations/**"]
    },
    "contract:breaking": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
